[17.304, "o", "\u001b[H\u001b[6G\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[92m\u25cf\u001b[3G\u001b[39m\u001b[1mUpdate\u001b[22m(src/billing.ts)\r\u001b[1B\u001b[37m\u001b[2m  \u23bf \u00a0\u001b[22m\u001b[39mAdded \u001b[1m1\u001b[22m line, removed \u001b[1m1\u001b[22m line\u001b[K\r\u001b[5C\u001b[1B\u001b[37m\u001b[2m 4 \u001b[22m }\r\u001b[1B\u001b[39m \u001b[3G   \u001b[37m\u001b[2m 5 \u001b[22m \u001b[39m\u001b[K\r\u001b[1B     \u001b[37m\u001b[2m 6 \u001b[22m \u001b[95mexport\u001b[37m \u001b[96mfunction\u001b[37m \u001b[93mtotal\u001b[37m(items: \u001b[93mLineItem\u001b[37m[]): \u001b[96mnumber\u001b[37m {\r\u001b[5C\u001b[1B\u001b[91m 7 -\u001b[37m\u001b[2m  return items.reduce((sum, item) => sum + item.price, 0);                  \r\u001b[5C\u001b[1B\u001b[22m\u001b[92m 7 +\u001b[37m  \u001b[95mreturn\u001b[37m items.\u001b[93mreduce\u001b[37m((sum, item) => sum + item.unitPrice, \u001b[94m0\u001b[37m);              \r\u001b[6C\u001b[1B\u001b[2m8\u001b[10G\u001b[22m}\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[37m\u001b[2mSearched for \u001b[22m\u001b[1m1\u001b[22m\u001b[2m pattern \u001b[22m\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[97m\u25cf\u001b[3G\u001b[39mI\u001b[5Grenamed\u001b[13G\u001b[94mLineItem.price\u001b[28G\u001b[39mto\u001b[31G\u001b[94munitPrice\u001b[41G\u001b[39min\u001b[44G\u001b[94msrc/billing.ts\u001b[39m.\u001b[60GThe\u001b[64Ginterface\u001b[74Gfield\u001b[80Gand\u001b[84Gthe\u001b[88Gone\r\u001b[2C\u001b[1Buse in \u001b[94mtotal()\u001b[39m now read\u001b[27G\u001b[94munitPrice\u001b[39m.\r\u001b[2B \u001b[3GThis br\u001b[11Gaks \u001b[94msrc/cart.ts\u001b[39m,\u001b[28Gwhich you didn't ask me to touch. It imports \u001b[94mLineItem\u001b[39m and reads\r\u001b[2C\u001b[1B\u001b[94ma.price\u001b[39m on line 4,\u001b[22Gso it will fail\u001b[38Gtype-checking\u001b[52Guntil\u001b[58Gthat\u001b[63Gline\u001b[68Gis\u001b[71Gchanged\u001b[79Gto\r\u001b[2C\u001b[1B\u001b[94ma.unitPrice\u001b[39m.\u001b[16GI\u001b[18Gleft\u001b[23Git\u001b[26Galone\u001b[32Gbecause\u001b[40Gyou\u001b[44Glimited\u001b[52Gthe\u001b[56Gchange\u001b[63Gto\u001b[66G\u001b[94mbilling.ts\u001b[39m.\u001b[78GTell\u001b[83Gme\u001b[86Gif\u001b[89Gyou\r\u001b[2C\u001b[1Bwant\u001b[8Gme to fix it too.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\u001b[26;1H\u001b[24;3H"]
[17.396, "o", "\u001b[H\u001b[37m\u001b[2m  \u23bf \u00a0\u001b[22m\u001b[39mAdded\u001b[12G\u001b[1m1\u001b[14G\u001b[22mline,\u001b[20Gremoved\u001b[28G\u001b[1m1\u001b[30G\u001b[22mline\r\u001b[5C\u001b[1B\u001b[37m\u001b[2m 4 \u001b[22m }\r\u001b[1B\u001b[39m \u001b[3G   \u001b[37m\u001b[2m 5 \u001b[22m \u001b[39m\u001b[K\r\u001b[1B     \u001b[37m\u001b[2m 6 \u001b[22m \u001b[95mexport\u001b[37m \u001b[96mfunction\u001b[37m \u001b[93mtotal\u001b[37m(items: \u001b[93mLineItem\u001b[37m[]): \u001b[96mnumber\u001b[37m {\r\u001b[5C\u001b[1B\u001b[91m 7 -\u001b[37m\u001b[2m  return items.reduce((sum, item) => sum + item.price, 0);                  \r\u001b[5C\u001b[1B\u001b[22m\u001b[92m 7 +\u001b[37m  \u001b[95mreturn\u001b[37m items.\u001b[93mreduce\u001b[37m((sum, item) => sum + item.unitPrice, \u001b[94m0\u001b[37m);              \r\u001b[6C\u001b[1B\u001b[2m8\u001b[10G\u001b[22m}\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[37m\u001b[2mSearched for \u001b[22m\u001b[1m1\u001b[22m\u001b[2m pattern \u001b[22m\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[97m\u25cf\u001b[3G\u001b[39mI\u001b[5Grenamed\u001b[13G\u001b[94mLineItem.price\u001b[28G\u001b[39mto\u001b[31G\u001b[94munitPrice\u001b[41G\u001b[39min\u001b[44G\u001b[94msrc/billing.ts\u001b[39m.\u001b[60GThe\u001b[64Ginterface\u001b[74Gfield\u001b[80Gand\u001b[84Gthe\u001b[88Gone\r\u001b[2C\u001b[1Buse in \u001b[94mtotal()\u001b[39m now read\u001b[27G\u001b[94munitPrice\u001b[39m.\r\u001b[2B \u001b[3GThis br\u001b[11Gaks \u001b[94msrc/cart.ts\u001b[39m,\u001b[28Gwhich you didn't ask me to touch. It imports \u001b[94mLineItem\u001b[39m and reads\r\u001b[2C\u001b[1B\u001b[94ma.price\u001b[39m on line 4,\u001b[22Gso it will fail\u001b[38Gtype-checking\u001b[52Guntil\u001b[58Gthat\u001b[63Gline\u001b[68Gis\u001b[71Gchanged\u001b[79Gto\r\u001b[2C\u001b[1B\u001b[94ma.unitPrice\u001b[39m.\u001b[16GI\u001b[18Gleft\u001b[23Git\u001b[26Galone\u001b[32Gbecause\u001b[40Gyou\u001b[