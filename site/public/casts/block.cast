[22.189, "o", "\u001b[H\u001b[37m\u001b[2m  \u23bf \u00a0\u001b[22m\u001b[91mError: PreToolUse:Edit hook error: [\"/opt/hatchlock/scripts/guard-escape-hatches.sh\"]: \r\u001b[2C\u001b[1B\u001b[39m   \u001b[91m[HatchLock Guardrail] Blocked: this edit would hide a type error in \r\u001b[5C\u001b[1B/tmp/shop/src/billing.ts:\r\u001b[1B\u001b[39m \u001b[3G   \u001b[91m1:  // @ts-ignore\u001b[39m\u001b[K\r\u001b[1B     \u001b[91mFix the type in\u001b[22Gtea\u001b[26G. Only add \"hatchl\u001b[45Gck-allow: <reason>\" on the same line if the user\r\u001b[5C\u001b[1Bexplicitly\u001b[17Gaske\u001b[22G for this suppression or\u001b[47Gthe line is a test that\u001b[71Gexpects a type error;\r\u001b[5C\u001b[1Bnever add it on your own to get past this check.\r\u001b[5C\u001b[1B\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[91mThis \u001b[12Gook comes from the hatchlock@in\u001b[44Gine p\u001b[50Gugin.\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[37m\u001b[2mRan \u001b[22m\u001b[1m1\u001b[22m\u001b[2m shell command \u001b[22m\u001b[39m\u001b[K\r\u001b[2B\u001b[97m\u25cf\u001b[3G\u001b[39mThe guardrail hook blocked the plain \u001b[94m@ts-ignore\u001b[39m. You\u001b[56Gexplicitly\u001b[67Gasked\u001b[73Gfor\u001b[77Gthis\r\u001b[2C\u001b[1Bsuppression,\u001b[16Gand\u001b[20Gthe\u001b[24Ghook's\u001b[31Grule\u001b[36Gallows\u001b[43Ga\u001b[45G\u001b[94mhatchlock-allow\u001b[61G\u001b[39mmarker\u001b[68Gon\u001b[71Gthe\u001b[75Gsame\u001b[80Gline\u001b[85Gin\u001b[88Gthat\r\u001b[2C\u001b[1Bcase, so I'll add it\u001b[24Gwith\u001b[29Gthe\u001b[33Greason.\r\u001b[2B\u001b[37m\u001b[2m\u25cf\u001b[3G\u001b[22m\u001b[39m\u001b[1mUpdate\u001b[22m(src/billing.ts)\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[37m\u001b[2m \u001b[3G\u001b[22m\u001b[39mRunning \u001b[1m1\u001b[22m shell command\u2026\u001b[K\u001b[26;1H\u001b[24;3H"]
[22.204, "o", "\u001b[H\r\u001b[14C\u001b[20B\u001b[37m\u001b[2mrunning PreTo\u001b[29GlUse\u001b[34Ghook \u00b7 11s \u00b7 \u2193\u001b[49G987 tokens \u00b7 thinking)\u001b[22m\u001b[39m\u001b[26;1H\u001b[24;3H"]
