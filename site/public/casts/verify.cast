[16.763, "o", "\u001b[H     \u001b[37m\u001b[2m 2 \u001b[22m   name: \u001b[96mstring\u001b[37m;\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[91m 3 -\u001b[37m\u001b[2m  price: number;                                                            \r\u001b[5C\u001b[1B\u001b[22m\u001b[92m 3 +\u001b[12G\u001b[37munitPrice: \u001b[96mnumber\u001b[37m;                                                        \r\u001b[5C\u001b[1B\u001b[2m 4 \u001b[22m }\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[37m\u001b[2m 5 \u001b[22m \u001b[39m\u001b[K\r\u001b[6C\u001b[1B\u001b[37m\u001b[2m6\u001b[10G\u001b[22m\u001b[95mexport\u001b[37m \u001b[96mfunction\u001b[37m \u001b[93mtotal\u001b[37m(items: \u001b[93mLineItem\u001b[37m[]): \u001b[96mnumber\u001b[37m {\r\u001b[5C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[92m\u25cf\u001b[3G\u001b[39m\u001b[1mUpdate\u001b[22m(src/billing.ts)\u001b[K\r\u001b[1B\u001b[37m\u001b[2m  \u23bf \u00a0\u001b[22m\u001b[39mAdded\u001b[12G\u001b[1m1\u001b[14G\u001b[22mline,\u001b[20Gremoved\u001b[28G\u001b[1m1\u001b[30G\u001b[22mline\r\u001b[1B \u001b[3G   \u001b[37m\u001b[2m 4 \u001b[22m }\u001b[39m\u001b[K\r\u001b[1B     \u001b[37m\u001b[2m 5 \u001b[22m \u001b[39m\u001b[K\r\u001b[6C\u001b[1B\u001b[37m\u001b[2m6\u001b[10G\u001b[22m\u001b[95mexport\u001b[37m \u001b[96mfunction\u001b[37m \u001b[93mtotal\u001b[37m(items: \u001b[93mLineItem\u001b[37m[]): \u001b[96mnumber\u001b[37m {\r\u001b[5C\u001b[1B\u001b[91m 7 -\u001b[37m\u001b[2m  return items.reduce((sum, item) => sum + item.price, 0);                  \r\u001b[5C\u001b[1B\u001b[22m\u001b[92m 7 +\u001b[37m  \u001b[95mreturn\u001b[37m items.\u001b[93mreduce\u001b[32G\u001b[37m(su\u001b[36G, item) => sum + item.unitPrice, \u001b[94m0\u001b[37m);              \r\u001b[5C\u001b[1B\u001b[2m 8 \u001b[22m }\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[37m\u001b[2mSearched for \u001b[22m\u001b[1m1\u001b[22m\u001b[2m pattern \r\u001b[2B\u001b[22m\u001b[97m\u25cf\u001b[3G\u001b[39m\u001b[K\u0