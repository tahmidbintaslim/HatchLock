[22.507, "o", "\u001b[H     \u001b[91m[HatchLock Guardrail] Bl\u001b[31Gc\u001b[33Ged: this edit would hide a ty\u001b[63Ge erro\u001b[70G in \u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[91m/tmp/sh\u001b[14Gp/src/bill\u001b[25Gng.ts:\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[91m1:  \u001b[11G/ @ts-ignore\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[91mFix\u001b[10Gthe \u001b[15Gype instead. Only add \"hatchlock-allow: <reason>\" on the same line if the user\r\u001b[5C\u001b[1Bexplicitl\u001b[16G asked for this suppression \u001b[45Gr the line is a test that expects a type error;\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[91mnever add it on you\u001b[27Gown to get past this check.\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[5C\u001b[1B\u001b[91mThis hook comes from the hatchlock@inline plugin.\r\u001b[5C\u001b[1B\u001b[39m\u001b[K\r\u001b[2C\u001b[1B\u001b[37m\u001b[2mRan \u001b[22m\u001b[1m1\u001b[22m\u001b[2m shell command \r\u001b[2C\u001b[1B\u001b[22m\u001b[39m\u001b[K\r\u001b[1B\u001b[97m\u25cf\u001b[3G\u001b[39mThe\u001b[7Gguardrail\u001b[17Ghook\u001b[22Gblocked\u001b[30Gthe\u001b[34Gplain\u001b[40G\u001b[94m@ts-ignore\u001b[39m.\u001b[52GYou\u001b[56Gexplicitly\u001b[67Gasked\u001b[73Gfor\u001b[77Gthis\r\u001b[1B \u001b[3Gsuppression, and the hook's rule \u001b[37Gllows a \u001b[94mhatchlock-allow\u001b[39m marker on the same line\u001b[85Gin\u001b[88Gthat\r\u001b[2C\u001b[1Bcase, \u001b[10Go I'll a\u001b[19Gd it\u001b[24Gwith the r\u001b[35Gason.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[37m\u001b[2m\u25cf\u001b[3G\u001b[22m\u001b[39m\u001b[1mUpdate\u001b[22m(src/billing.ts)\r\u001b[1B\u001b[K\r\u001b[1B\u001b[37m\u001b[2m\u25cf\u001b[3G\u001b[22m\u001b[39mRunning\u001b[11G\u001b[1m1\u001b[13G\u001b[22mshell\u001b[19Gcommand\u2026\r\u001b[1C\u001b[1B\u001b[37m\u001b[2m \u23bf  $ npm run typecheck; echo \"exit=$?\"; git diff\r\u001b[2C\u001b[2B\u001b[22m\u001b[91mTem\u001b[43G\u001b[37m\u001b[2m2\u001b[22m\u001b[39m\u001b[26;1H\u001b[24;3H"]
[22.546, "o", "\u001b[H\u001b[6G\u001b[K\r\u001b[2C\u001b[1B\u001b[37m\u001b[2mRan \u001b[22m\u001b[1m1\u001b[22m\u001b[2m shell command \u001b[22m\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[97m\u25cf\u001b[3G\u001b[39mThe guardrail hook blocked the plain \u001b[94m@ts-ignore\u001b[39m. You explicitly asked for this\u001b[K\r\u001b[2C\u001b[1Bsuppression, and the hook's rule allows a \u001b[94mhatchlock-allow\u001b[39m marker on the same line in that\r\u001b[2C\u001b[1Bcase, so I'll add it with the reason.\u001b[K\r\u001b[2B\u001b[92m\u25cf\u001b[3G\u001b[39m\u001b[1mUpdate\u001b[22m(src/billing.ts)\u001b[K\r\u001b[1B\u001b[37m\u001b[2m  \u23bf \u00a0\u001b[22m\u001b[39mAdded\u001b[12G\u001b[1m1\u001b[14G\u001b[22mline\r\u001b[2C\u001b[1B   \u001b[7G\u001b[37m\u001b[2m 8 \u001b[22m }\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[37m\u001b[2m  9 \u001b[22m \r\u001b[1B\u001b[39m \u001b[3G   \u001b[37m\u001b[2m 10 \u001b[22m \u001b[95mexport\u001b[37m \u001b[96mfunction\u001b[37m \u001b[93mformatTotal\u001b[37m(items: \u001b[93mLineItem\u001b[37m[]): \u001b[96mstring\u001b[37m {\u001b[39m\u001b[K\r\u001b[2C\u001b[1B   \u001b[92m 11 +\u001b[37m  \u001b[90m// @ts-ignore hatchlock-allow: user explicitly requested @ts-ignore here\u001b[37m \u001b[39m\u001b[K\r\u001b[2C\u001b[1B   \u001b[37m\u001b[2m 12 \u001b[22m   \u001b[96mconst\u001b[37m amount: \u001b[96mnumber\u001b[37m = \u001b[93mtotal\u001b[37m(items).\u001b[93mtoFixed\u001b[37m(\u001b[94m2\u001b[37m);\r\u001b[5C\u001b[1B\u001b[2m 13 \u001b[22m   \u001b[95mreturn\u001b[37m \u001b[92m`$\u001b[37m${amount}\u001b[92m`\u001b[37m;\r\u001b[1B\u001b[39m \u001b[3G   \u001b[37m\u001b[2m 14 \u001b[22m }\u001b[39m\u001b[K\r\u001b[14C\u001b[5B\u001b[37m\u001b[2m12s \u00b7 \u2193\u001b[22m\u001b[39m \u001b[37m\u001b[2m1.0k t\u001b[30Gkens)\u001b[22m\u001b[39m\u001b[K\u001b[26;1H\u001b[24;3H"]
