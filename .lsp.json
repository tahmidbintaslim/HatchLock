{
  "zig": {
    "command": "zls",
    "extensionToLanguage": {
      ".zig": "zig"
    }
  },
  "elixir": {
    "command": "elixir-ls",
    "extensionToLanguage": {
      ".ex": "elixir",
      ".exs": "elixir"
    }
  },
  "dart": {
    "command": "dart",
    "args": [
      "language-server",
      "--protocol=lsp"
    ],
    "extensionToLanguage": {
      ".dart": "dart"
    }
  },
  "bash": {
    "command": "bash-language-server",
    "args": [
      "start"
    ],
    "extensionToLanguage": {
      ".sh": "shellscript",
      ".bash": "shellscript",
      ".zsh": "shellscript"
    }
  },
  "terraform": {
    "command": "terraform-ls",
    "args": [
      "serve"
    ],
    "extensionToLanguage": {
      ".tf": "terraform",
      ".tfvars": "terraform"
    }
  },
  "r": {
    "command": "R",
    "args": [
      "--slave",
      "-e",
      "languageserver::run()"
    ],
    "extensionToLanguage": {
      ".r": "r",
      ".R": "r"
    }
  }
}
