[21.932, "o", "\u001b[H     \u001b[37m\u001b[2m[\"/opt/hatchlock/scripts/verify-project.sh\"]: [HatchLock Project Check] The project \r\u001b[5C\u001b[1Bdoes not pass its \u001b[25Gheck\u001b[30G y\u001b[33Gt. Fix th\u001b[43Gse errors before finishing:\u001b[22m\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[37m\u001b[2m== tsc ==\u001b[22m\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[37m\u001b[2msrc/cart.ts(4,38): error TS2339: Property 'price' does not exist on type 'LineItem'.\r\u001b[19C\u001b[1B4\r\u001b[5C\u001b[1B\u001b[22m\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[37m\u001b[2mThis hook comes from the hatchlock@inline plugin.\r\u001b[5C\u001b[1B\u001b[22m\u001b[39m\u001b[K\r\u001b[1B\u001b[92m\u25cf\u001b[3G\u001b[39m\u001b[1mUpdate\u001b[22m(src/cart.ts)\r\u001b[1B\u001b[37m\u001b[2m  \u23bf \u00a0\u001b[22m\u001b[39mAdded \u001b[1m1\u001b[22m line, removed\u001b[28G\u001b[1m1\u001b[30G\u001b[22mline\r\u001b[1B     \u001b[37m\u001b[2m 1 \u001b[22m \u001b[95mimport\u001b[37m \u001b[96mtype\u001b[37m { \u001b[93mLineItem\u001b[37m } \u001b[95mfrom\u001b[37m \u001b[92m\"./billing\"\u001b[37m;\r\u001b[6C\u001b[1B\u001b[2m2\u001b[10G\u001b[22m\u001b[39m\u001b[K\r\u001b[6C\u001b[1B\u001b[37m\u001b[2m3\u001b[10G\u001b[22m\u001b[95mexport\u001b[37m \u001b[96mfunction\u001b[37m \u001b[93mcheapest\u001b[37m(items: \u001b[93mLineItem\u001b[37m[]): \u001b[93mLineItem\u001b[37m | \u001b[94mundefined\u001b[37m {\r\u001b[5C\u001b[1B\u001b[91m 4 -\u001b[37m\u001b[2m  return [...items].sort((a, b) => a.price - b.price)[0];                   \r\u001b[5C\u001b[1B\u001b[22m\u001b[92m 4 +\u001b[37m  \u001b[95mreturn\u001b[37m [...items].\u001b[93msort\u001b[37m((a, b) => a.unitPrice - b.unitPrice)[\u001b[94m0\u001b[37m];           \r\u001b[5C\u001b[1B\u001b[2m 5 \u001b[22m }\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[37m\u001b[2m \u001b[3G\u001b[22m\u001b[39mType-check\u001b[14Gthe\u001b[18Gproject\u001b[26Gwith\u001b[31Gtsc\r\u001b[1C\u001b[1B\u001b[37m\u001b[